{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reinventx-forms/form",
	"title": "Reinventx Form",
	"category": "widgets",
	"icon": "email-alt2",
	"description": "Embed a Reinventx form. Submissions land in your Reinventx Forms inbox with source context.",
	"keywords": [ "form", "contact", "lead" ],
	"textdomain": "reinventx-forms",
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"multiple": true
	},
	"editorScript": "rvtx-block-form"
}
